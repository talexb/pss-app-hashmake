#!/usr/bin/perl

use strict;
use warnings;

#  2026-0721: Main script for HashMake. Collect command line arguments, set up
#  the operating environment.

#  2026-0820: Make these arguments mirror the ones from make(1).

use Getopt::Std;
use Data::Dumper;

use lib 'lib';

use App::HashMake;

{
    #  d - Turn on debug info.
    #  n - Print the commands that would be executed.
    #  f - Specify a non-standard hash.makefile
    #  y - Working directory (because we can't write to target directory)
    #  B - Force rebuild (proceed as if there's no index file).
    #  t - Touch intead of running the commands. (Pretend commands were run.)

    getopts ( 'dnf:y:Bt', \my %opts );

    # print "Dumping out the opts hash:\n" . Dumper ( \%opts );

    my ( $result, $output ) = App::HashMake::run ( \%opts );

    #  The module just collects the errors and the output but doesn't actually
    #  send anything. This allows us to do testing without having to capture
    #  the output.  This may or may not be a smart approach.

    if ( @{ $output->{ err } } ) {

      print STDERR join ( "\n", @{ $output->{ err } } ) . "\n";
    }
    if ( @{ $output->{ out } } ) {

      print join ( "\n", @{ $output->{ out } } ) . "\n";
    }
    exit ( $result );
}
